{
    "name": "portal",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "^18"
    },
    "scripts": {
        "build": "next build",
        "build:prod": "scripts/build.sh",
        "dev": "docker compose -f docker/compose.yaml up",
        "dev:next": "next dev",
        "lint": "next lint",
        "start": "next start",
        "prepare": "cd ../.. && husky install components/portal/.husky",
        "test": "jest --ci",
        "test:cov": "jest --coverage",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@azure/msal-browser": "3.15.0",
        "@azure/msal-react": "2.0.17",
        "@fluentui/react-components": "9.54.1",
        "@fluentui/react-icons": "2.0.242",
        "@hookform/resolvers": "2.9.11",
        "@monaco-editor/react": "4.5.1",
        "@tanstack/react-query": "4.24.4",
        "i18next": "23.2.3",
        "next": "14.1.1",
        "next-i18next": "14.0.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-hook-form": "7.43.1",
        "react-i18next": "13.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@playwright/test": "1.39.0",
        "@testing-library/jest-dom": "5.17.0",
        "@testing-library/react": "14.3.1",
        "@testing-library/user-event": "14.4.3",
        "@types/node": "20.1.2",
        "@types/react": "18.2.6",
        "@types/react-dom": "18.2.4",
        "@types/react-test-renderer": "18.0.0",
        "@types/uuid": "9.0.1",
        "@typescript-eslint/eslint-plugin": "5.59.5",
        "@typescript-eslint/parser": "5.59.5",
        "eslint": "8.40.0",
        "eslint-config-next": "13.4.1",
        "eslint-config-prettier": "8.8.0",
        "eslint-plugin-etc": "2.0.3",
        "eslint-plugin-import": "2.27.5",
        "eslint-plugin-react": "7.32.2",
        "eslint-plugin-unicorn": "46.0.0",
        "husky": "8.0.3",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "jwt-decode": "4.0.0",
        "lint-staged": "13.2.2",
        "prettier": "2.8.4",
        "sanitize.css": "13.0.0",
        "sass": "1.62.1",
        "ts-node": "10.9.2",
        "typescript": "5.2.2",
        "typescript-fsa": "3.0.0",
        "typescript-fsa-reducers": "1.2.2"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs}": [
            "eslint --cache --fix",
            "prettier --write -u"
        ],
        "*": [
            "prettier --write -u"
        ]
    }
}
